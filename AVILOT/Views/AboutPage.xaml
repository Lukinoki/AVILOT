<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AVILOT.Views.AboutPage"
             xmlns:vm="clr-namespace:AVILOT.ViewModels"
             Title="{Binding Title}">
    
    <ContentPage.BindingContext>
        <vm:AboutViewModel />
    </ContentPage.BindingContext>
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Accent">#96d1ff</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollView Grid.Row="1">
            <Label Text="Welcome to AVILOT"></Label>
        </ScrollView>
        <StackLayout>
            <Button Text="Open Import Page" Clicked="Button_Clicked"></Button>
            <Button Text="Open Question Page" Clicked="Button_Clicked_2"></Button>
            <Label TextType="Html">
                <![CDATA[
    This is <strong style="color:red">HTML</strong> text. <img src="https://cdn.cloudflare.steamstatic.com/steam/apps/364190/capsule_616x353.jpg?t=1572321559">
    ]]>
            </Label>
        </StackLayout>
        
    </Grid>

</ContentPage>
